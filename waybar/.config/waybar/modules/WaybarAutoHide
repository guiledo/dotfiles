#!/usr/bin/env bash

STATE_FILE="$HOME/.config/waybar/modules/.Locked"
AUTO_FILE="$HOME/.config/waybar/modules/.Visible"
CONFIG_FILE="$HOME/.config/waybar/config.jsonc"
POLL_DELAY=0.10

# [ GREP FUNCTIONS ]

get_cursor_pos() { timeout 0.5 hyprctl cursorpos 2>/dev/null; }

get_resolution() {
    timeout 0.5 hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused==true) | "\(.width)x\(.height)"'
}

get_bar_position() {
    grep -m1 '"position"' "$CONFIG_FILE" | sed -E 's/.*"position":[[:space:]]*"([^"]+)".*/\1/'
}

get_tiled_on_active_ws() {
    local ws=$(timeout 0.5 hyprctl activeworkspace 2>/dev/null | awk '/workspace ID/ {print $3}')
    [ -z "$ws" ] && return 1
    timeout 0.5 hyprctl clients 2>/dev/null | awk -v ws="$ws" '
        /^Window /{cur_ws="";floating="";hidden=0}
        /^\s*workspace:/{cur_ws=$2}
        /^\s*floating:/{floating=$2}
        /^\s*hidden:/{hidden=$2}
        cur_ws==ws && floating==0 && hidden==0 {count++;cur_ws=""}
        END{print count+0}'
}

focused_special_ws() {
    timeout 0.5 hyprctl monitors 2>/dev/null | awk '
        BEGIN {focused=0; special=-1}
        /^Monitor / {focused=0; special=-1}
        /focused: yes/ {focused=1}
        /special workspace:/ {special=$3}
        END {exit !(focused==1 && special != -1 && special != 0)}'
}

# [ AUTO-HIDE WAYBAR ]

autohide_mode() {
# Kill other instances of this script to ensure clean recovery
pgrep -f "WaybarAutoHide$" | grep -v $$ | xargs kill -9 2>/dev/null

bar_visible=false
# Initial force show
pkill -SIGUSR2 waybar
bar_visible=true
touch "$AUTO_FILE"

# Signal handler for wake-up recovery
trap "bar_visible=false; pkill -SIGUSR2 waybar; bar_visible=true" SIGCONT

while true; do
    # Ensure waybar is running
    if ! pgrep -x "waybar" >/dev/null; then
        sleep 2
        continue
    fi

    # Verify if Hyprland is reachable
    if ! timeout 0.5 hyprctl version >/dev/null 2>&1; then
        sleep 2
        bar_visible=false
        continue
    fi

    CURSOR=$(get_cursor_pos)
    if [ -z "$CURSOR" ]; then
        sleep 1
        continue
    fi
    X=$(echo "$CURSOR" | cut -d',' -f1)
    Y=$(echo "$CURSOR" | cut -d',' -f2)

    RES=$(get_resolution)
    if [ -z "$RES" ]; then
        sleep 1
        continue
    fi
    WIDTH=${RES%x*}
    HEIGHT=${RES#*x}

    POSITION=$(get_bar_position)

    tiled=$(get_tiled_on_active_ws)
    [ $? -ne 0 ] && sleep 1 && continue
    
    special=$(focused_special_ws && echo 1 || echo 0)

    case "$POSITION" in
        top)
            EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.01}')
            EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.1}')
            SHOW_CONDITION=$(( Y <= EDGE1 ))
            HIDE_CONDITION=$(( Y > EDGE2 ))
            ;;
        bottom)
            EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.9}')
            EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.99}')
            SHOW_CONDITION=$(( Y >= EDGE2 ))
            HIDE_CONDITION=$(( Y < EDGE1 ))
            ;;
        left)
            EDGE1=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.01}')
            EDGE2=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.1}')
            SHOW_CONDITION=$(( X <= EDGE1 ))
            HIDE_CONDITION=$(( X > EDGE2 ))
            ;;
        right)
            EDGE1=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.9}')
            EDGE2=$(awk -v w="$WIDTH" 'BEGIN {printf "%d", w * 0.99}')
            SHOW_CONDITION=$(( X >= EDGE2 ))
            HIDE_CONDITION=$(( X < EDGE1 ))
            ;;
        *)
            EDGE1=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.01}')
            EDGE2=$(awk -v h="$HEIGHT" 'BEGIN {printf "%d", h * 0.1}')
            SHOW_CONDITION=$(( Y <= EDGE1 ))
            HIDE_CONDITION=$(( Y > EDGE2 ))
            ;;
    esac

    if (( special || SHOW_CONDITION )); then
        if ! $bar_visible; then
            pkill -SIGUSR2 waybar
            bar_visible=true
            touch "$AUTO_FILE"
        fi
    elif (( HIDE_CONDITION || tiled == 0 )); then
        if $bar_visible; then
            pkill -SIGUSR1 waybar
            bar_visible=false
            rm -f "$AUTO_FILE"
        fi
    fi

    sleep "$POLL_DELAY"
done
}

# [ TOGGLE WAYBAR ]

toggle_mode() {
if [ -f "$STATE_FILE" ]; then
    rm "$STATE_FILE"
    tiled=$(get_tiled_on_active_ws)

    if focused_special_ws
    then
        pkill -SIGUSR2 waybar
    else
        pkill -SIGUSR1 waybar
        sleep 0.5
    fi

    nohup "$0" >/dev/null 2>&1 &
else
    touch "$STATE_FILE"
    pkill -f "WaybarAutoHide$"
    pkill -SIGUSR2 waybar
fi
}

# [ WAYBAR MODULE & TOGGLE ]

module_mode() {
if [ -f "$STATE_FILE" ]
    then printf '{"text":"","tooltip":"[ TASKBAR LOCKED ]"}\n'
    else printf '{"text":"","tooltip":"[ TASKBAR UNLOCKED ]"}\n'
fi
}

case "$1" in
    toggle) toggle_mode ;;
    module) module_mode ;;
    *) [ -f "$STATE_FILE" ] || autohide_mode ;;
esac
