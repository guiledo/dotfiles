{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-gemini-auth@latest"],
  //"model": "anthropic/claude-sonnet-4-5",
  //"small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": false,
  "default_agent": "plan",
  // "instructions": [
    // "~/.config/opencode/rules/performance.md"
  // ],
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
      }
    },
    "plan": {
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
      }
    }
  },
  "permission": {
    "write": "ask",
    "edit": "ask",
    "bash": {
      "git *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "paru *": "ask",
      "rm *": "ask",
      "*": "ask"
    }
  }
}

