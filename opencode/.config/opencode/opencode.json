{
  "$schema": "https://opencode.ai/config.json",
  //"model": "anthropic/claude-sonnet-4-5",
  //"small_model": "anthropic/claude-haiku-4-5",
  "autoupdate": false,
  "default_agent": "plan",
  "instructions": [
    "~/.config/opencode/rules/performance.md"
  ],
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": "ask"
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "git *": "allow",
      "ls": "allow",
      "cat *": "allow",
      "pacman *":"ask",
      "paru *": "ask",
      "rm *": "ask",
      "*": "ask"
    }
  }
}

