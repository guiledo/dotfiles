{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "autoupdate": false,
  "default_agent": "plan",
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "agent": {
    "build": {
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true
      }
    },
    "plan": {
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false
      }
    },
    "mentor": {
      "hidden": false,
      "mode": "primary",
      "instructions": [
        "~/.config/opencode/rules/cs-mentor.md"
      ],
      "tools": {
        "write": false,
        "edit": false
      }
    }
  },
  "permission": {
    "write": {
      "**/.opencode/plans/*.md": "allow",
      "*": "ask"
    },
    "edit": {
      "**/.opencode/plans/*.md": "allow",
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "git*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "man*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "cd*": "allow",
      "rg*": "allow",
      "eza*": "allow",
      "tree*": "allow",
      "fd*": "allow",
      "echo*": "allow",
      "which*": "allow",
      "pwd*": "allow",
      "chmod*": "ask",
      "chown*": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "paru*": "ask",
      "rm*": "ask"
    }
  }
}
