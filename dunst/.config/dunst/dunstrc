[global]
    # Monitor where notifications should be displayed
    monitor = 0

    # Follow focus or use the mouse for placement
    follow = mouse

    # Dimensions
    width = 300
    height = 300
    offset = 30x30
    origin = top-right

    # Display settings
    transparency = 0
    padding = 10
    horizontal_padding = 10
    frame_width = 1
    frame_color = "#91d7e3"
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    line_height = 0

    # Colors (Catppuccin Mocha-like)
    [urgency_low]
        background = "#1e1e2e"
        foreground = "#cdd6f4"
        timeout = 5

    [urgency_normal]
        background = "#1e1e2e"
        foreground = "#cdd6f4"
        timeout = 10

    [urgency_critical]
        background = "#1e1e2e"
        foreground = "#f38ba8"
        frame_color = "#f38ba8"
        timeout = 0
